# Pick ONE provider. With nothing set, the chatbot runs in offline "rules" mode (no LLM).

# --- Claude (Anthropic) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5-5

# --- Google Gemini (Google AI Studio) ---
# Free key: https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=...
# LLM_MODEL=gemini-3.6-flash     # or gemini-3.8-flash, gemini-3.5-flash-lite, gemini-3.1-pro-preview

# --- OpenAI ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4.1-mini

# --- Local model with Ollama (free, private; needs a model with tool support) ---
#   ollama pull qwen2.5:7b && ollama serve
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434/v1

# --- Any other OpenAI-compatible server (LM Studio, vLLM, Groq, OpenRouter, ...) ---
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=...
# LLM_MODEL=...

# --- Tuning (defaults shown) ---
# CHATBOT_PORT=3000
# LLM_MAX_TOKENS=2048
# LLM_TEMPERATURE=0.2
# MAX_TOOL_ROUNDS=8
# MAX_TOOL_RESULT_CHARS=15000
# MAX_HISTORY_MESSAGES=40
# FILE_SERVER_URL=http://localhost:4000
