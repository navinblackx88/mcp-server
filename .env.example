# Used by docker-compose.yml (copy to .env). On Railway, set these as service variables instead.

# Shared secrets between the services. Generate with: openssl rand -hex 32
FILE_SERVER_TOKEN=change-me-file-server-token
MCP_AUTH_TOKEN=change-me-mcp-token

# Login for the chat page (user "admin" unless CHATBOT_USERNAME is set)
CHATBOT_PASSWORD=change-me

# LLM: set one of these, or leave all empty for offline rules mode
GEMINI_API_KEY=          # Google AI Studio: https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_PROVIDER=gemini        # anthropic | openai | gemini | ollama | rules
# LLM_MODEL=gemini-3.6-flash
